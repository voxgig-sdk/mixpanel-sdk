
# Model definitions.
@"@voxgig/apidef/model/apidef.aontu"
@"@voxgig/sdkgen/model/sdkgen.aontu"


# SDK Details.
name: 'mixpanel'
origin: 'voxgig-sdk'
def: 'mixpanel-profile-only.json'


# API Information
@"api/api-info.aontu"


# SDK Configuration.
@"config.aontu"


# SDK Entities
@"entity/entity-index.aontu"


# SDK Features.
@"feature/feature-index.aontu"
 

# SDK Targets.
@"target/target-index.aontu"


# Operation workflows.
@"flow/flow-index.aontu"


# adopt: true — fork of the real senecajs repo; keeps its .github/LICENSE
# etc. instead of generating into an empty folder.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/mixpanel-provider'
  sdkrel: '../../voxgig-sdk/mixpanel-sdk'
  adopt: true
}

