
# Model definitions.
@"@voxgig/apidef/model/apidef.aontu"
@"@voxgig/sdkgen/model/sdkgen.aontu"


# SDK Details.
name: 'mixpanel'
origin: 'voxgig-sdk'
def: 'mixpanel-profile-only.json'


# API Information
@"api/api-info.aontu"


# SDK Configuration.
@"config.aontu"


# SDK Entities
@"entity/entity-index.aontu"


# SDK Features.
@"feature/feature-index.aontu"
 

# SDK Targets.
@"target/target-index.aontu"


# Operation workflows.
@"flow/flow-index.aontu"


# Seneca provider plugin generates out-of-tree into the sibling repo.
# adopt: true — this is a fork of the real senecajs repo (its hand-written
# source was a stub, entity: {}), kept .github/.gitignore/LICENSE/
# CODE_OF_CONDUCT on purpose rather than starting from an empty folder.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/mixpanel-provider'
  sdkrel: '../../voxgig-sdk/mixpanel-sdk'
  adopt: true
}

